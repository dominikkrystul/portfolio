{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "audit:site": "npm run build && node scripts/audit-site.mjs",
    "test": "vitest",
    "test:e2e": "vitest run",
    "test:ci": "npm run format:check && npm run lint && npm run type-check && npm run test:e2e && npm run audit:site",
    "preview": "vite preview",
    "type-check": "vue-tsc -b --pretty",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "^4.1.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.6.0",
    "globals": "^16.5.0",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.1",
    "prettier": "^3.7.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.46.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.11",
    "vitest-browser-vue": "^2.1.0",
    "vue-tsc": "^3.3.8"
  }
}
